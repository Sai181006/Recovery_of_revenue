{
  "name": "revenue-recovery-phase-1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --experimental-strip-types src/api.ts",
    "scenarios": "node --experimental-strip-types src/cli.ts scenarios",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "node tools/check.mjs syntax",
    "lint": "node tools/check.mjs lint",
    "format": "node tools/check.mjs format",
    "format:check": "node tools/check.mjs format-check",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run scenarios"
  }
}
