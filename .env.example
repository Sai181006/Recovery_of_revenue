# Test-mode values only. Never commit real values or a populated .env file.
APP_MODE=production
PORT=3000
HOST=127.0.0.1
DATA_PATH=data/recovery.sqlite
PUBLIC_DIR=public
WEBHOOK_ENABLED=false
# Live webhook context. Both default to false: no customer contact is ever eligible.
# Set to true only in Razorpay test mode to see contact decisions (still simulated).
WEBHOOK_MERCHANT_ID=merchant_demo
WEBHOOK_ASSUME_CONSENT=false
WEBHOOK_ASSUME_CONTACT_ROUTE=false

# Access. READ_ONLY=true disables every merchant control (public demo).
# ADMIN_TOKEN is a shared secret sent as "Authorization: Bearer <token>"; it is not
# per-user authentication. Production mode requires it for /cases, /webhook-receipts
# and controls.
READ_ONLY=false
ADMIN_TOKEN=

# Optional integrations. Leave blank for the credential-independent demo.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=
# For npm run evaluate:live only (billed). Or use `ant auth login` instead of a key.
ANTHROPIC_API_KEY=
ADVISOR_MODEL=claude-opus-5-5
